# ╔══════════════════════════════════════════════════════════════════╗
# ║  Laravel — Azure App Service Production Environment            ║
# ║                                                                 ║
# ║  INSTRUCTIONS:                                                  ║
# ║  1. Search for "REPLACE_" and fill in your actual Azure values  ║
# ║  2. Copy this file as .env on the Azure App Service             ║
# ║  3. Or set these as Application Settings in Azure Portal        ║
# ╚══════════════════════════════════════════════════════════════════╝

APP_NAME=MiniInstagram
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://REPLACE_BACKEND_NAME.azurewebsites.net

# ── Frontend URL (Azure Static Web Apps) ──
FRONTEND_URL=https://REPLACE_FRONTEND_NAME.azurestaticapps.net

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ── Logging ──
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Azure Database for PostgreSQL Flexible Server ──
DB_CONNECTION=pgsql
DB_HOST=REPLACE_POSTGRES_SERVER.postgres.database.azure.com
DB_PORT=5432
DB_DATABASE=REPLACE_DB_NAME
DB_USERNAME=REPLACE_DB_USER
DB_PASSWORD=REPLACE_DB_PASSWORD
DB_SSLMODE=require

# ── Session ──
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=REPLACE_BACKEND_NAME.azurewebsites.net
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none

# ── Queue / Cache / Broadcast ──
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Sanctum ──
SANCTUM_STATEFUL_DOMAINS=REPLACE_FRONTEND_NAME.azurestaticapps.net,REPLACE_BACKEND_NAME.azurewebsites.net

# ── CORS ──
CORS_ALLOWED_ORIGINS=https://REPLACE_FRONTEND_NAME.azurestaticapps.net

# ── Mail (configure if needed) ──
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@REPLACE_BACKEND_NAME.azurewebsites.net"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
